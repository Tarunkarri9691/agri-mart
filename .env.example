# ---- Backend ----
DATABASE_URL=sqlite:///./agri.db          # docker-compose uses PostgreSQL
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=1                      # set 0 and use `alembic upgrade head` in production
ENABLE_SCHEDULER=1                        # hourly re-ranking + alerts, daily price sync, drift check, weekly retrain
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=20

# ---- Assumptions (see docs/assumptions.md) ----
RATE_PER_QUINTAL_KM=0.6
TRUCK_CAPACITY_QUINTALS=100
STORAGE_COST_PER_QUINTAL_DAY=1.0

# ---- Real road distance (OSRM). Public demo server is rate-limited: self-host for real use ----
USE_OSRM=0
OSRM_URL=https://router.project-osrm.org

# ---- Real data: free key from https://data.gov.in -> My Account ----
DATA_GOV_API_KEY=

# ---- SMS / WhatsApp alerts via Twilio (console = just log) ----
NOTIFY_PROVIDER=console                   # console | twilio_sms | twilio_whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                              # e.g. +14155550100  or  whatsapp:+14155238886

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
